<launch>
  <arg name="initial_search_z" default="2.0"/>
  <arg name="initial_search_yaw" default="20.0"/>
  <arg name="initial_search_xy" default="5.0"/>
  <!-- FAST-LIVO2 local odometry plus the copied FLOAM global localizer. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="publish_lidar_tf" default="true"/>
  <arg name="allow_identity_lidar_tf" default="false"/>
  <!-- This launch is live-safe. The dedicated full-rosbag launch selects
       simulated time, camera rebasing, and the recorded-cart calibration. -->
  <arg name="camera_timestamp_mode" default="preserve"/>
  <arg name="config_file" default="$(find fast_livo2)/config/nuc_realtime.yaml"/>
  <arg name="calibration_file" default="$(find fast_livo2)/config/calibration/new_cart_measured.yaml"/>
  <arg name="map_path" default="$(find fast_livo2)/maps/full_campus.pcd"/>
  <arg name="lidar_topic" default="/lidar103/velodyne_points"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="camera_topic" default="/camera/color/image_raw"/>
  <arg name="estimator_lidar_topic" default="/fast_livo2/input/lidar"/>
  <arg name="estimator_imu_topic" default="/fast_livo2/input/imu"/>
  <arg name="estimator_camera_topic" default="/fast_livo2/input/image"/>
  <arg name="fast_local_odom_topic" default="/aft_mapped_to_init"/>
  <arg name="map_frame" default="map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="use_fast_local_prediction" default="true"/>
  <arg name="enable_fast_livo" default="true"/>
  <arg name="fast_prediction_warmup_scans" default="5"/>

  <param name="use_sim_time" type="bool" value="$(arg use_sim_time)"/>
  <param name="relocalization" type="bool" value="true"/>
  <param name="mapFileName" type="str" value="$(arg map_path)"/>
  <!-- Keep the FLOAM frontend on the same raw VLP-16 topic used by the
       original ALIVE stack. FAST-LIVO2 continues to consume the adapted
       estimator topic independently. -->
  <param name="lidarTopic" type="str" value="$(arg lidar_topic)"/>
  <param name="lidarPoseTopic" type="str" value="/pose"/>
  <param name="fast_local_odom_topic" type="str" value="$(arg fast_local_odom_topic)"/>
  <param name="map_frame" type="str" value="$(arg map_frame)"/>
  <param name="base_frame" type="str" value="$(arg base_frame)"/>
  <param name="fast_local_parent_frame" type="str" value="camera_init"/>
  <param name="fast_local_child_frame" type="str" value="aft_mapped"/>
  <param name="fast_local_max_time_error" type="double" value="0.15"/>
  <param name="fast_local_wait_timeout" type="double" value="0.3"/>
  <!-- First let copied FLOAM establish a stable scan-to-map lock. FAST-LIVO2
       is anchored only after these corrections, so its local frame cannot
       pull a rough /initialpose away from the campus map. -->
  <param name="use_fast_local_prediction" type="bool" value="$(arg use_fast_local_prediction)"/>
  <param name="fast_prediction_warmup_scans" type="int" value="$(arg fast_prediction_warmup_scans)"/>
  <!-- FLOAM-only fallback guard.  These limits are deliberately not applied
       when synchronized FAST-LIVO2 motion is available. -->
  <param name="floam_fallback_max_translation_per_scan" type="double" value="0.8"/>
  <param name="floam_fallback_max_rotation_deg_per_scan" type="double" value="8.0"/>
  <param name="floam_fallback_max_tilt_deg" type="double" value="20.0"/>
  <param name="allow_identity_lidar_tf" type="bool" value="$(arg allow_identity_lidar_tf)"/>
  <!-- Remove returns from the golf-cart body before FLOAM feature extraction.
       Bounds/rotation mirror the ALIVE point_cloud_single vehicle-footprint
       filter for the recorded E2O cart. -->
  <param name="floam_remove_vehicle_footprint" type="bool" value="true"/>
  <param name="vehicle_length" type="double" value="3.590"/>
  <param name="vehicle_width" type="double" value="2.2"/>
  <param name="floam_vehicle_crop_min_z" type="double" value="-1.5"/>
  <param name="floam_vehicle_crop_max_z" type="double" value="10.0"/>
  <param name="floam_vehicle_crop_pitch_rad" type="double" value="-0.35"/>
  <param name="scan_line" type="int" value="16"/>
  <param name="scan_period" type="double" value="0.10"/>
  <param name="vertical_angle" type="double" value="1.0"/>
  <param name="map_resolution" type="double" value="0.35"/>
  <param name="max_dis" type="double" value="300.0"/>
  <param name="min_dis" type="double" value="0.5"/>
  <!-- Ground attitude/height proposal, bounded geometric seed search,
       then FLOAM point-to-line/plane refinement and consecutive validation. -->
  <param name="floam_initial_search_xy_m" value="$(arg initial_search_xy)"/>
  <param name="floam_initial_search_yaw_deg" value="$(arg initial_search_yaw)"/>
  <param name="floam_initial_search_z_m" value="$(arg initial_search_z)"/>
  <param name="floam_ceres_num_threads" type="int" value="2"/>
  <param name="floam_ceres_max_iterations" type="int" value="4"/>
  <include if="$(arg enable_fast_livo)" file="$(find fast_livo2)/launch/fast_livo2_velodyne.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="rviz" value="false"/>
    <arg name="publish_compatibility" value="false"/>
    <arg name="publish_lidar_tf" value="$(arg publish_lidar_tf)"/>
    <arg name="camera_timestamp_mode" value="$(arg camera_timestamp_mode)"/>
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="lidar_topic" value="$(arg lidar_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="estimator_lidar_topic" value="$(arg estimator_lidar_topic)"/>
    <arg name="estimator_imu_topic" value="$(arg estimator_imu_topic)"/>
    <arg name="estimator_camera_topic" value="$(arg estimator_camera_topic)"/>
  </include>

  <group unless="$(arg enable_fast_livo)">
    <rosparam command="load" file="$(arg calibration_file)"/>
    <node pkg="fast_livo2" type="fast_livo2_calibration_guard.py"
          name="fast_livo2_calibration_guard" output="screen" required="true">
      <param name="publish_lidar_tf" value="$(arg publish_lidar_tf)"/>
    </node>
  </group>

  <node pkg="fast_livo2" type="fast_livo2_floam_frontend"
        name="fast_livo2_floam_frontend" output="screen" required="true"/>

  <node pkg="fast_livo2" type="fast_livo2_floam_localizer"
        name="fast_livo2_floam_localizer" output="screen" required="true">
    <rosparam command="load" file="$(find fast_livo2)/config/floam_odometry_params.yaml"/>
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="fast_livo2_full_rviz"
          args="-d $(find fast_livo2)/rviz/fast_livo2_full_localization.rviz"
          output="screen"/>
  </group>
</launch>
