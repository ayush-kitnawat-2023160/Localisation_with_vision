<launch>
  <!-- FAST-LIVO2 is the only continuous motion estimator.  This launch uses
       NDT/GICP only for initial PCD anchoring and periodic map verification. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="camera_timestamp_mode" default="preserve"/>
  <arg name="config_file" default="$(find fast_livo2)/config/nuc_realtime.yaml"/>
  <arg name="calibration_file" default="$(find fast_livo2)/config/calibration/new_cart_measured.yaml"/>
  <arg name="map_path" default="$(find fast_livo2)/maps/full_campus.pcd"/>
  <arg name="lidar_topic" default="/lidar103/velodyne_points"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="camera_topic" default="/camera/color/image_raw"/>
  <arg name="fast_odom_topic" default="/aft_mapped_to_init"/>
  <arg name="initial_search_xy" default="5.0"/>
  <arg name="initial_search_yaw_deg" default="25.0"/>
  <arg name="periodic_check_sec" default="3.0"/>

  <param name="use_sim_time" type="bool" value="$(arg use_sim_time)"/>

  <include file="$(find fast_livo2)/launch/fast_livo2_velodyne.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="rviz" value="false"/>
    <arg name="publish_compatibility" value="false"/>
    <arg name="publish_lidar_tf" value="true"/>
    <arg name="camera_timestamp_mode" value="$(arg camera_timestamp_mode)"/>
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="lidar_topic" value="$(arg lidar_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
  </include>

  <node pkg="fast_livo2" type="fast_livo2_pcd_localizer"
        name="fast_livo2_pcd_localizer" output="screen" required="true">
    <param name="map_path" value="$(arg map_path)"/>
    <param name="lidar_topic" value="$(arg lidar_topic)"/>
    <param name="fast_odom_topic" value="$(arg fast_odom_topic)"/>
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="initial_search_xy" value="$(arg initial_search_xy)"/>
    <param name="initial_search_yaw_deg" value="$(arg initial_search_yaw_deg)"/>
    <param name="periodic_check_sec" value="$(arg periodic_check_sec)"/>
    <param name="local_map_radius" value="35.0"/>
    <param name="initial_max_fitness" value="0.65"/>
    <param name="check_max_fitness" value="0.45"/>
    <param name="min_inlier_fraction" value="0.25"/>
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="fast_livo2_pcd_rviz"
          args="-d $(find fast_livo2)/rviz/fast_livo2_full_localization.rviz"
          output="screen"/>
  </group>
</launch>
