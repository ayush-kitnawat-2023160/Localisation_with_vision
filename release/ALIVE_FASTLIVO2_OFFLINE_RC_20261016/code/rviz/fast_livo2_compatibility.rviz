Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: camera_init
      Plane Cell Count: 20
      Cell Size: 1
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Registered LiDAR
      Topic: /cloud_registered
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Use Fixed Frame: true
    - Class: rviz/Path
      Enabled: true
      Name: FAST-LIVO2 trajectory
      Topic: /fast_livo2/native_path
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.05
  Enabled: true
  Global Options:
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.6
      Yaw: 0.8
