Panels:
  - Class: rviz/Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz/TF
      Name: Global and local TF
      Show Axes: true
      Show Names: true
    - Class: rviz/Path
      Name: Globally aligned FAST-LIVO2 trajectory
      Topic: /fast_livo2/global_trajectory
      Color: 255; 200; 0
      Line Style: Lines
      Line Width: 0.08
    - Class: rviz/PointCloud2
      Name: FAST-LIVO2 local LiDAR cloud
      Topic: /cloud_registered
      Style: Points
      Size (Pixels): 2
      Use Fixed Frame: false
    - Class: rviz/PointCloud2
      Name: Raw LiDAR input (10 Hz)
      Topic: /lidar103/velodyne_points
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 180; 0
      Use Fixed Frame: false
    - Class: rviz/PointCloud2
      Name: PCD map (visualization only)
      Topic: /apriori_map
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 220; 220; 220
      Use Fixed Frame: true
    - Class: rviz/Pose
      Name: Robust GPS prior
      Topic: /fast_livo2/gps_map_pose
      Color: 0; 170; 255
  Views:
    Current:
      Angle: 0.0
      Class: rviz/TopDownOrtho
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 800.0
      Target Frame: <Fixed Frame>
      X: -278.0
      Y: 207.0
      Value: TopDownOrtho (rviz)
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
