Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
      Plane Cell Count: 20
      Cell Size: 5
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Full campus map (/apriori_map)
      Topic: /apriori_map
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Use Fixed Frame: true
    - Class: rviz/Path
      Enabled: true
      Name: FAST-LIVO2 plus FLOAM trajectory
      Topic: /fast_livo2/trajectory
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz/Odometry
      Enabled: true
      Name: Global /odom
      Topic: /odom
      Keep: 100
      Shape:
        Value: Axes
    - Class: rviz/Pose
      Enabled: true
      Name: Global /pose
      Topic: /pose
      Shape: Arrow
    - Class: rviz/Image
      Enabled: true
      Name: Camera (/camera/color/image_raw)
      Image Topic: /camera/color/image_raw
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 80
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 1.0
      Yaw: 0.8
      Value: Orbit (rviz)
