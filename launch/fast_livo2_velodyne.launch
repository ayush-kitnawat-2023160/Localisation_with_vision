<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="publish_compatibility" default="true"/>
  <arg name="publish_lidar_tf" default="false"/>
  <arg name="use_sensor_adapter" default="true"/>
  <!-- Keep the native upstream camera_init->aft_mapped diagnostic transform
       private when a bridge is publishing the public vehicle TF tree. -->
  <arg name="native_tf_topic" default="/tf"/>
  <arg name="camera_timestamp_mode" default="preserve"/>
  <arg name="config_file" default="$(find fast_livo2)/config/nuc_realtime.yaml"/>
  <arg name="calibration_file" default="$(find fast_livo2)/config/calibration/new_cart_measured.yaml"/>

  <arg name="lidar_topic" default="/lidar103/velodyne_points"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="camera_topic" default="/camera/color/image_raw"/>

  <arg name="estimator_lidar_topic" default="/fast_livo2/input/lidar"/>
  <arg name="estimator_imu_topic" default="/fast_livo2/input/imu"/>
  <arg name="estimator_camera_topic" default="/fast_livo2/input/image"/>

  <param name="use_sim_time" type="bool" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(arg config_file)"/>
  <rosparam command="load" file="$(arg calibration_file)"/>
  <group if="$(arg use_sensor_adapter)">
    <param name="common/lid_topic" value="$(arg estimator_lidar_topic)"/>
    <param name="common/imu_topic" value="$(arg estimator_imu_topic)"/>
    <param name="common/img_topic" value="$(arg estimator_camera_topic)"/>
  </group>
  <group unless="$(arg use_sensor_adapter)">
    <param name="common/lid_topic" value="$(arg lidar_topic)"/>
    <param name="common/imu_topic" value="$(arg imu_topic)"/>
    <param name="common/img_topic" value="$(arg camera_topic)"/>
  </group>

  <node pkg="fast_livo2" type="fast_livo2_calibration_guard.py"
        name="fast_livo2_calibration_guard" output="screen" required="true">
    <param name="publish_lidar_tf" value="$(arg publish_lidar_tf)"/>
  </node>

  <node if="$(arg use_sensor_adapter)" pkg="fast_livo2"
        type="fast_livo2_sensor_adapter.py" name="fast_livo2_sensor_adapter"
        output="screen" required="true">
    <param name="source_lidar_topic" value="$(arg lidar_topic)"/>
    <param name="source_imu_topic" value="$(arg imu_topic)"/>
    <param name="source_camera_topic" value="$(arg camera_topic)"/>
    <param name="camera_timestamp_mode" value="$(arg camera_timestamp_mode)"/>
  </node>

  <!-- The upstream FAST-LIVO2 camera loader reads /laserMapping/*, so this
       node name is intentional. -->
  <node pkg="fast_livo2" type="fastlivo_mapping" name="laserMapping"
        output="screen" required="true">
    <remap from="/tf" to="$(arg native_tf_topic)"/>
  </node>

  <group if="$(arg publish_compatibility)">
    <node pkg="fast_livo2" type="fast_livo2_compatibility.py"
          name="fast_livo2_compatibility" output="screen" required="true"/>
  </group>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="fast_livo2_rviz"
          args="-d $(find fast_livo2)/rviz/fast_livo2_compatibility.rviz"
          output="screen"/>
  </group>
</launch>
