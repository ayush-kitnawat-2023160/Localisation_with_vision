<launch>
  <!-- OFFLINE ROS1 BAG ONLY: metric RGB-D KLT/PnP odometry with short ZED
       gyroscope rotation support. Does NOT need LiDAR, GPS or previous map.
       No base_link TF, no /pose, no FAST-LIVO2 estimator reset.
       NOT a full preintegrated/filter-based VIO implementation. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="calibration_file" default="$(find fast_livo2)/config/calibration/zedx_current.yaml"/>
  <arg name="image_topic" default="/zedx/zed_node/left/image_rect_color"/>
  <arg name="depth_topic" default="/zedx/zed_node/depth/depth_registered"/>
  <arg name="zed_imu_topic" default="/zedx/zed_node/imu/data"/>
  <arg name="lidar_health_topic" default="/lidar103/velodyne_points"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(arg calibration_file)"/>
  <node pkg="fast_livo2" type="fresh_zedx_camera_imu_odom.py"
        name="fresh_zedx_camera_imu_odom" output="screen">
    <param name="offline_only" value="true"/>
    <param name="require_imu_for_healthy" value="true"/>
    <param name="frame_period_sec" value="0.065"/>
    <param name="image_scale" value="0.65"/>
    <param name="max_output_gap_sec" value="0.65"/>
    <param name="max_image_silence_sec" value="0.7"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="imu_topic" value="$(arg zed_imu_topic)"/>
    <param name="lidar_topic" value="$(arg lidar_health_topic)"/>
  </node>
</launch>
