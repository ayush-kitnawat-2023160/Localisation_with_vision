<launch>
  <!-- REQUIRES preinstalled visual-fixed-lag-shadow-dev-20261016 image.
       SAFE TO RUN IN PARALLEL FOR RVIZ INSPECTION ONLY. Never remap to cart. -->
  <node pkg="fast_livo2" type="ros_fixed_lag_pose_smoother_20261016.py"
        name="step3_fixed_lag_smoother_preview" output="screen" required="false">
    <param name="source" value="/fast_livo2/step3_global_pose"/>
    <param name="lag_sec" value="0.23"/>
    <param name="fit_window_sec" value="1.15"/>
    <param name="fit_degree" value="1"/>
    <param name="max_gap_sec" value="0.35"/>
    <param name="max_numeric_speed_mps" value="5.0"/>
    <param name="max_disagreement_m" value="1.0"/>
  </node>
</launch>
