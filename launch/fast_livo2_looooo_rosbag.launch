<launch>
  <!-- Fresh ZED X ROS-bag profile.
       Starts in LOCAL ODOMETRY + SENSOR-FAILSAFE mode without any saved map.
       Build/validate a map from the new recordings before enabling the
       global map-localizer; never silently load a legacy campus PCD. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="config_file" default="$(find fast_livo2)/config/failsafe_rosbag.yaml"/>
  <arg name="calibration_file"
       default="$(find fast_livo2)/config/calibration/zedx_current.yaml"/>
  <arg name="map_localizer_config"
       default="$(find fast_livo2)/config/map_failsafe_zedx_looooo.yaml"/>
  <arg name="map_localizer_enable" default="false"/>
  <arg name="map_path" default=""/>
  <arg name="visual_map_path" default=""/>

  <arg name="lidar_topic" default="/lidar103/velodyne_points"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="camera_topic" default="/zedx/zed_node/left/image_rect_color"/>
  <arg name="depth_topic" default="/zedx/zed_node/depth/depth_registered"/>
  <arg name="depth_info_topic" default="/zedx/zed_node/depth/camera_info"/>
  <arg name="camera_timestamp_mode" default="preserve"/>
  <arg name="max_camera_hz" default="5.0"/>

  <arg name="drop_sensor" default="none"/>
  <arg name="drop_start" default="15.0"/>
  <arg name="drop_duration" default="20.0"/>
  <arg name="record_trajectory" default="false"/>
  <arg name="trajectory_output" default="/tmp/looooo_failsafe_trajectory.csv"/>

  <include file="$(find fast_livo2)/launch/fast_livo2_failsafe_rosbag.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="map_localizer_config" value="$(arg map_localizer_config)"/>
    <arg name="lidar_topic" value="$(arg lidar_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="depth_topic" value="$(arg depth_topic)"/>
    <arg name="depth_info_topic" value="$(arg depth_info_topic)"/>
    <arg name="camera_timestamp_mode" value="$(arg camera_timestamp_mode)"/>
    <arg name="max_camera_hz" value="$(arg max_camera_hz)"/>
    <arg name="map_path" value="$(arg map_path)"/>
    <arg name="visual_voxel_map_path" value="$(arg visual_map_path)"/>
    <arg name="map_localizer_enable" value="$(arg map_localizer_enable)"/>
    <arg name="failsafe_frontends_enable" value="true"/>
    <arg name="visual_place_enable" value="false"/>
    <!-- Without a global-map localizer there can be no saved-map lock.
         Disable the map-lock requirement on sensor rejoin for this
         local-odometry-only ROS-bag profile. -->
    <arg name="map_primary_on_imu_failure" value="false"/>
    <arg name="map_primary_on_lidar_failure" value="false"/>
    <arg name="rgbd_color_rebase_with_shared_offset" value="false"/>
    <arg name="rgbd_use_klt" value="true"/>
    <arg name="rgbd_process_every_n" value="1"/>
    <arg name="record_trajectory" value="$(arg record_trajectory)"/>
    <arg name="trajectory_output" value="$(arg trajectory_output)"/>
    <arg name="drop_sensor" value="$(arg drop_sensor)"/>
    <arg name="drop_start" value="$(arg drop_start)"/>
    <arg name="drop_duration" value="$(arg drop_duration)"/>
  </include>
</launch>
